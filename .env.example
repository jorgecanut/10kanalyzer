# Copy to .env next to docker-compose.yml (Dockge loads this automatically).

# Host port the container publishes.
HTTP_PORT=8053

# Optional host folders. Defaults: ./data, ./edgar_cache and ./edgar_data next
# to the compose file. They must be writable by uid 10001 (the container user):
#   mkdir -p data edgar_cache edgar_data && sudo chown -R 10001:10001 data edgar_cache edgar_data
# STOCKY_DATA=./data
# EDGAR_CACHE=./edgar_cache
# EDGAR_DATA=./edgar_data

# There is no SEC identity setting: each user's account name and email is sent
# to the SEC as the contact for that user's requests.
