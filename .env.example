# Copy to .env next to docker-compose.yml (Dockge loads this automatically).

# Host port the container publishes.
HTTP_PORT=8053

# Optional host folders. Defaults: ./data, ./edgar_cache and ./edgar_data next
# to the compose file. They must be writable by uid 10001 (the container user):
#   mkdir -p data edgar_cache edgar_data && sudo chown -R 10001:10001 data edgar_cache edgar_data
# STOCKY_DATA=./data
# EDGAR_CACHE=./edgar_cache
# EDGAR_DATA=./edgar_data

# The admin: the one account (by email) with no limits, the Admin tab and the
# Market scan. Everyone else gets the limits below. Keep the real address here,
# in .env, which is not in git.
# STOCKY_ADMIN_EMAIL=you@example.com

# Limits for every other account (defaults shown). Runs reset at midnight UTC;
# users can ask for more from Options > Account and the admin grants them.
# STOCKY_RUNS_PER_DAY=20         pipeline runs started per day (each screener ticker is one)
# STOCKY_ACTIVE_RUNS=3           chart runs queued or running at once
# STOCKY_SCREENER_TICKERS=10     tickers per screener request (one batch at a time)
# STOCKY_FRESH_COOLDOWN=3600     seconds before the same ticker can be regenerated
# STOCKY_SIGNUPS_PER_HOUR=20     new accounts per hour, for the whole site

# There is no SEC identity setting: each user's account name and email is sent
# to the SEC as the contact for that user's requests.
